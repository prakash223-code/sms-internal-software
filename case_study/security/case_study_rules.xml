<odoo>
    <data>
        <!--  ══════════════ case.study ══════════════
                     Employee: READ case studies whose Case Study Department is
                     linked to the employee's own HR Department (hr.department),
                     plus any case study they are personally assigned to.
                     WRITE nothing — case study fields are HR-only.
                     HR: full access to everything, all departments.
                ══════════════════════════════════════════════  -->
        <record id="rule_case_study_employee_read_own_dept" model="ir.rule">
            <field name="name">Case Study: Employee reads own department + assigned</field>
            <field name="model_id" ref="model_case_study"/>
            <field name="domain_force">['|', ('department_id.hr_department_id.member_ids.user_id', '=', user.id),
                ('assigned_employee_ids.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_case_study_hr" model="ir.rule">
            <field name="name">Case Study: HR full access (all departments)</field>
            <field name="model_id" ref="model_case_study"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!--  ══════════════ case.study.timesheet ══════════════
                     Employee: READ timesheet lines only for case studies whose
                     department maps to their own HR department (or ones they're
                     assigned to). WRITE/CREATE/UNLINK only their own entries.
                     HR: full access to everything.
                ══════════════════════════════════════════════  -->
        <record id="rule_case_study_timesheet_employee_read_own_dept" model="ir.rule">
            <field name="name">Case Study Timesheet: Employee reads own department + assigned</field>
            <field name="model_id" ref="model_case_study_timesheet"/>
            <field name="domain_force">['|', ('case_study_id.department_id.hr_department_id.member_ids.user_id', '=',
                user.id), ('case_study_id.assigned_employee_ids.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_case_study_timesheet_employee_write_own" model="ir.rule">
            <field name="name">Case Study Timesheet: Employee edits only own entries</field>
            <field name="model_id" ref="model_case_study_timesheet"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="rule_case_study_timesheet_hr" model="ir.rule">
            <field name="name">Case Study Timesheet: HR full access</field>
            <field name="model_id" ref="model_case_study_timesheet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!--  ══════════════ case.study.document ══════════════
                     Employee: READ documents only for case studies whose
                     department maps to their own HR department (or ones they're
                     assigned to). WRITE/CREATE/UNLINK only documents THEY
                     uploaded, within that visible scope.
                     HR: full access to everything.
                ══════════════════════════════════════════════  -->
        <record id="rule_case_study_document_employee_read_own_dept" model="ir.rule">
            <field name="name">Case Study Document: Employee reads own department + assigned</field>
            <field name="model_id" ref="model_case_study_document"/>
            <field name="domain_force">['|', ('case_study_id.department_id.hr_department_id.member_ids.user_id', '=',
                user.id), ('case_study_id.assigned_employee_ids.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_case_study_document_employee_write_own" model="ir.rule">
            <field name="name">Case Study Document: Employee edits only own uploads</field>
            <field name="model_id" ref="model_case_study_document"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="rule_case_study_document_hr" model="ir.rule">
            <field name="name">Case Study Document: HR full access</field>
            <field name="model_id" ref="model_case_study_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>