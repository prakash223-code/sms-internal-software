<odoo>
    <data>
        <!--  ══════════════ case.study ══════════════
                     Employee: READ (view) every case study whose linked HR
                     Department matches the employee's own HR Department —
                     covers EVERYONE in that department, assigned or not.
                     PLUS anyone personally assigned (cross-department cases).
                     WRITE only if personally assigned — non-assigned employees
                     can view but never edit.
                     HR: full access to everything.
                ══════════════════════════════════════════════  -->
        <record id="rule_case_study_employee_read_all_dept" model="ir.rule">
            <field name="name">Case Study: Employee reads own department + assigned</field>
            <field name="model_id" ref="model_case_study"/>
            <field name="domain_force">['|', ('department_id.hr_department_id', '=', user.employee_id.department_id.id
                if user.employee_id and user.employee_id.department_id else -1), ('assigned_employee_ids.user_id', '=',
                user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_case_study_employee_write_assigned" model="ir.rule">
            <field name="name">Case Study: Employee edits only if personally assigned</field>
            <field name="model_id" ref="model_case_study"/>
            <field name="domain_force">[('assigned_employee_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_case_study_hr" model="ir.rule">
            <field name="name">Case Study: HR full access</field>
            <field name="model_id" ref="model_case_study"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!--  ══════════════ case.study.timesheet ══════════════
                     Employee: READ every timesheet line for case studies in
                     their own department (view-only for everyone). WRITE only
                     their own entries.
                ══════════════════════════════════════════════  -->
        <record id="rule_case_study_timesheet_employee_read_all_dept" model="ir.rule">
            <field name="name">Case Study Timesheet: Employee reads own department + assigned</field>
            <field name="model_id" ref="model_case_study_timesheet"/>
            <field name="domain_force">['|', ('case_study_id.department_id.hr_department_id', '=',
                user.employee_id.department_id.id if user.employee_id and user.employee_id.department_id else -1),
                ('case_study_id.assigned_employee_ids.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_case_study_timesheet_employee_write_own" model="ir.rule">
            <field name="name">Case Study Timesheet: Employee edits only own entries</field>
            <field name="model_id" ref="model_case_study_timesheet"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="rule_case_study_timesheet_hr" model="ir.rule">
            <field name="name">Case Study Timesheet: HR full access</field>
            <field name="model_id" ref="model_case_study_timesheet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!--  ══════════════ case.study.document ══════════════
                     Employee: READ every document for case studies in their own
                     department (view-only for everyone). WRITE only documents
                     THEY uploaded.
                ══════════════════════════════════════════════  -->
        <record id="rule_case_study_document_employee_read_all_dept" model="ir.rule">
            <field name="name">Case Study Document: Employee reads own department + assigned</field>
            <field name="model_id" ref="model_case_study_document"/>
            <field name="domain_force">['|', ('case_study_id.department_id.hr_department_id', '=',
                user.employee_id.department_id.id if user.employee_id and user.employee_id.department_id else -1),
                ('case_study_id.assigned_employee_ids.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_case_study_document_employee_write_own" model="ir.rule">
            <field name="name">Case Study Document: Employee edits only own uploads</field>
            <field name="model_id" ref="model_case_study_document"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="rule_case_study_document_hr" model="ir.rule">
            <field name="name">Case Study Document: HR full access</field>
            <field name="model_id" ref="model_case_study_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>