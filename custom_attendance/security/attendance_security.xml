<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         RECORD RULES: hr.attendance
         Employees see only their own records.
         HR and Attendance Manager see all.
    ================================================================ -->

    <record id="rule_attendance_employee_own" model="ir.rule">
        <field name="name">Attendance: Employee sees own records only</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_attendance_hr_all" model="ir.rule">
        <field name="name">Attendance: HR sees all records</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_attendance_manager_all" model="ir.rule">
        <field name="name">Attendance: Manager sees all records</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ================================================================
         RECORD RULES: attendance.monthly.summary
         Employees see only their own summary.
         HR and Manager see all.
    ================================================================ -->

    <record id="rule_monthly_summary_employee_own" model="ir.rule">
        <field name="name">Monthly Summary: Employee sees own record only</field>
        <field name="model_id" ref="custom_attendance.model_attendance_monthly_summary"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_monthly_summary_hr_all" model="ir.rule">
        <field name="name">Monthly Summary: HR sees all records</field>
        <field name="model_id" ref="custom_attendance.model_attendance_monthly_summary"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_monthly_summary_manager_all" model="ir.rule">
        <field name="name">Monthly Summary: Manager sees all records</field>
        <field name="model_id" ref="custom_attendance.model_attendance_monthly_summary"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ================================================================
         RECORD RULES: hr.leave / hr.leave.allocation
         GLOBAL — restricts WRITE to HR officers, or the employee on
         their own record while still pending. Deliberately GLOBAL (no
         <field name="groups">) so it ANDs unconditionally over every
         other rule — including whatever grants a Team Lead or "manager"
         employee_role incidental access elsewhere in the stack.

         Team Leads get notified on request submission (see
         hr_leave_extension.py / hr_leave_allocation_extension.py) but
         must NEVER be able to edit, approve, or refuse — only HR does,
         matching leave_validation_type='hr' / allocation_validation_type='hr'
         on every leave type in data/leave_type_data.xml.

         perm_read is left untouched here (True, unrestricted) — Team
         Leads still need to be able to open the notification and view
         the record; only write/unlink are locked down.
    ================================================================ -->

    <record id="rule_hr_leave_read_own" model="ir.rule">
        <field name="name">Time Off: employee can always read own records</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('hr.group_hr_user') else [('employee_id.user_id',
            '=', user.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hr_leave_write_hr_or_own" model="ir.rule">
        <field name="name">Time Off: WRITE restricted to HR or own pending record</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('hr.group_hr_user') else [('employee_id.user_id',
            '=', user.id), ('state', 'in', ('draft', 'confirm'))]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hr_leave_allocation_read_own" model="ir.rule">
        <field name="name">Allocation: employee can always read own records</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('hr.group_hr_user') else [('employee_id.user_id',
            '=', user.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hr_leave_allocation_write_hr_or_own" model="ir.rule">
        <field name="name">Allocation: WRITE restricted to HR or own pending record</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('hr.group_hr_user') else [('employee_id.user_id',
            '=', user.id), ('state', 'in', ('draft', 'confirm'))]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>